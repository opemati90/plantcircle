{
  "name": "plantcircle",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @plantcircle/mobile start",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "maestro test apps/mobile/e2e/maestro"
  },
  "devDependencies": {
    "prettier": "3.10.0",
    "typescript": "6.0.3"
  }
}
